{
  "extends": [
    "github>casse-boubou/ha-addon-workflows//.github/renovate.json"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s+"
      ],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/{{package}}",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStrings": ["ARG RUSTDESK_SERVER_VERSION=(?<currentValue>.+?)\\s+"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rustdesk/rustdesk-server",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["rustdesk/rustdesk-server"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "RustDesk-server"
    }
  ]
}
